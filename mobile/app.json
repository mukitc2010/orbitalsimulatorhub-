{
  "expo": {
    "name": "Orbital Simulator Hub",
    "slug": "orbital-simulator-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030616",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030616"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.orbitalsimulatorhub.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.orbitalsimulatorhub.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030616"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "description": "Futuristic 3D satellite orbit simulator. Launch satellites into LEO, MEO and GEO orbits around a holographic Earth, learn Newton's laws and orbital mechanics formulas, and test yourself with space quizzes."
  }
}
