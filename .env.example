# Database (optional; app runs without it)
DATABASE_URL=mysql://user:password@localhost:3306/satellite_sim

# Supabase DB (for running main-site tables script only; get from Dashboard → Project Settings → Database → Connection string → URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Supabase client (browser) — Vite uses VITE_*, Next.js uses NEXT_PUBLIC_*
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Server
PORT=3000
NODE_ENV=development

# AI Content Generation (Claude-powered via OpenClaw)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Social posting (when POST_TO_SOCIAL=1)
# POST_TO_SOCIAL=1
# LINKEDIN_ACCESS_TOKEN=your_token  # Get via: node scripts/linkedin-get-token.js
# For token script (run first):
# LINKEDIN_CLIENT_ID=your_client_id
# LINKEDIN_CLIENT_SECRET=your_client_secret

# Monetization (Support section in footer)
# VITE_KOFI_URL=https://ko-fi.com/yourname
# VITE_BMC_URL=https://buymeacoffee.com/yourname
# VITE_ADSENSE_ID=ca-pub-xxxxxxxxxx

# Qiskit Quantum Assist (for Quantum Space AGI simulator)
# QASSIST_URL=http://localhost:8000
# VITE_QASSIST_URL=http://localhost:8000       # Client-side (Vite)
# NEXT_PUBLIC_QASSIST_URL=http://localhost:8000  # Client-side (Next.js)

# Optional (from your spec)
# JWT_SECRET=your_secret_key_here
# VITE_APP_ID=your_app_id
# OAUTH_SERVER_URL=https://api.manus.im
# VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
