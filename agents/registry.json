{
  "version": 2,
  "totalAgents": 10,
  "why": "Ten owners cover the apps that ship. The previous 139-role list had two written charters, and its group totals did not add up to 139.",
  "operatingRules": {
    "productionBranch": "main",
    "stagingBranch": "pre-production",
    "directProductionWrites": false,
    "oneImplementationOwner": true,
    "requiredChecks": ["npm run agents:check", "npm run test:run", "npm run build"],
    "promotion": "Only the release agent may fast-forward a tested pre-production commit into main."
  },
  "groups": [
    { "id": "orchestration", "count": 1 },
    { "id": "product", "count": 7 },
    { "id": "control", "count": 2 }
  ],
  "agents": [
    {
      "id": "chief-orchestrator",
      "group": "orchestration",
      "charter": "agents/roles/chief-orchestrator.md",
      "owns": ["agents/registry.json", "agents/OPERATING_MODEL.md", "agents/roles/**"],
      "checks": ["npm run agents:check"]
    },
    {
      "id": "public-site",
      "group": "product",
      "charter": "agents/roles/public-site.md",
      "owns": ["client/src/pages/**", "client/src/components/**", "client/src/data/**", "client/src/index.css", "client/index.html", "client/public/**"],
      "checks": ["npm run test:run", "npm run build"]
    },
    {
      "id": "orbit-simulator",
      "group": "product",
      "charter": "agents/roles/orbit-simulator.md",
      "owns": ["client/src/orbitPhysics.ts", "client/src/orbitPhysics.test.ts", "client/src/orbitalUtils.ts", "client/src/orbitalClient.ts", "client/src/components/EarthVisualization.tsx", "client/src/components/HomeSpaceScene.tsx", "client/src/components/qsagi/**", "client/src/pages/OrbitMissionControl.tsx", "client/src/pages/Simulator.tsx", "server/orbital.ts", "server/orbital_mechanics.py", "server/qsagi/**", "shared/**", "simulation/**"],
      "checks": ["npm run test:run", "npm run build"]
    },
    {
      "id": "astrobot",
      "group": "product",
      "charter": "agents/roles/astrobot.md",
      "owns": ["lib/astrobot/**", "server/astrobot.ts", "server/astrobot-api.ts", "api/astrobot/**", "api/chat.ts", "client/src/astrobotKnowledge.ts", "client/src/components/astrobot/**", "client/src/pages/AstroBot.tsx", "client/src/lib/oracleAgent.test.ts"],
      "checks": ["npm run test:run -- client/src/lib/oracleAgent.test.ts", "npm run build"]
    },
    {
      "id": "content",
      "group": "product",
      "charter": "agents/roles/content.md",
      "owns": ["content/**", "docs/**", "scripts/space-news/**", "scripts/content-agent.js", "scripts/content-rewrite-agent.js", "scripts/content-scheduler.js", "scripts/generate-blog-post.js", "scripts/generate-rss.js", "client/src/data/spaceNews.json", "agents/DAILY_SPACE_NEWS_EDITOR.md"],
      "checks": ["npm run news:test", "npm run build"]
    },
    {
      "id": "platform",
      "group": "product",
      "charter": "agents/roles/platform.md",
      "owns": ["server/**", "api/**", "drizzle/**", "space-agi-swarm-backend/**", "n8n/**"],
      "checks": ["npm run test:run", "npm run build"]
    },
    {
      "id": "community",
      "group": "product",
      "charter": "agents/roles/community.md",
      "owns": ["community/app/**", "community/components/**", "community/lib/**", "community/supabase/**", "community/middleware.ts"],
      "checks": ["npm run build --prefix community"]
    },
    {
      "id": "astronaut-robot",
      "group": "product",
      "charter": "agents/roles/astronaut-robot.md",
      "owns": ["ai-astronaut-simulator/**", "client/src/components/RobotSimulationScene.tsx", "client/src/components/RobotSimulationScene.css", "client/src/pages/AIAstronautRobotSimulator.tsx"],
      "checks": ["npm run build", "npm run build --prefix ai-astronaut-simulator"]
    },
    {
      "id": "quality-security",
      "group": "control",
      "charter": "agents/roles/quality-security.md",
      "owns": ["client/src/**/*.test.ts", "client/src/**/*.test.tsx", "scripts/space-news/test_*.py"],
      "checks": ["npm run test:run", "npm run build"]
    },
    {
      "id": "release",
      "group": "control",
      "charter": "agents/roles/release.md",
      "owns": [".github/workflows/**", "vercel.json", "netlify.toml"],
      "checks": ["npm run test:run", "npm run build"]
    }
  ]
}
