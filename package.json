{
  "name": "satellite-simulator-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:astronaut": "cd ai-astronaut-simulator && npm run dev",
    "dev": "concurrently -n v,api \"vite\" \"node --import tsx server/_core/api-only.ts\"",
    "dev:3002": "concurrently -n v,api \"cross-env PORT=3002 API_PORT=3003 vite\" \"cross-env PORT=3003 node --import tsx server/_core/api-only.ts\"",
    "dev:single": "node --import tsx server/_core/index.ts",
    "dev:3001": "cross-env PORT=3001 node --import tsx server/_core/index.ts",
    "dev:vite": "vite",
    "dev:api": "node --import tsx server/_core/api-only.ts",
    "dev:swarm": "cd space-agi-swarm-backend && .venv/Scripts/python -m uvicorn main:app --reload --port 8000",
    "build": "tsc -p tsconfig.server.json && vite build",
    "build:client": "npm run generate:rss && vite build && node -e \"import('fs').then(fs => fs.copyFileSync('dist/index.html','dist/404.html'))\"",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "generate:rss": "node scripts/generate-rss.js",
    "generate:post": "node scripts/generate-blog-post.js",
    "auto-deploy": "node scripts/auto-deploy-after-post.js",
    "setup": "node scripts/setup-everything.js",
    "verify": "node scripts/verify-setup.js",
    "complete": "node scripts/complete-setup.js",
    "start": "node dist/server/_core/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "agents:check": "node scripts/check-agent-registry.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:main-site": "node scripts/run-main-site-tables.js",
    "news:preview": "python scripts/space-news/agent.py",
    "news:generate": "python scripts/space-news/agent.py --write",
    "news:test": "python -m unittest discover -s scripts/space-news -p test_*.py",
    "content:generate": "node scripts/content-agent.js",
    "content:dry-run": "node scripts/content-agent.js --dry-run",
    "content:rewrite": "node scripts/content-rewrite-agent.js",
    "content:schedule": "node scripts/content-scheduler.js",
    "seo:auto": "node scripts/auto-seo-update.js",
    "openclaw:update": "node scripts/openclaw-full-update.js",
    "sync:auto": "node scripts/auto-sync-github.mjs",
    "sync:once": "node scripts/auto-sync-github.mjs --once",
    "check:node": "node scripts/check-node-runtime.mjs",
    "prebuild": "npm run check:node",
    "prebuild:client": "npm run check:node"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.98.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "katex": "^0.16.33",
    "msgpackr": "^1.11.8",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "superjson": "^2.2.0",
    "three": "^0.170.0",
    "wouter": "^2.12.0",
    "zod": "^3.23.0"
  },
  "overrides": {
    "@react-spring/shared": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@react-spring/animated": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@react-spring/core": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@react-spring/three": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@react-three/drei": {
      "@react-three/fiber": "$@react-three/fiber",
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vercel/node": "^5.6.6",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.28.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
