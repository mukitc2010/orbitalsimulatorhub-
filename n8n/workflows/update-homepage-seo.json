        "jsCode": "// Generate optimized SEO for homepage\n// Updates meta tags to improve Google rankings\n\nconst currentDate = new Date().toISOString().split('T')[0];\nconst year = new Date().getFullYear();\n\n// Generate fresh SEO data with current year and trending keywords\nconst seoUpdate = {\n  path: '/',\n  title: `Orbital Simulator Hub | orbitalsimulatorhub.com — Satellite Orbit Simulator & Space Learning ${year}`,\n  description: `Free interactive 3D satellite orbit simulator ${year}. Learn orbital mechanics, NASA physics, space science. Real-time LEO, MEO, GEO orbit visualization. Perfect for students, scientists, and PhD researchers. Updated ${currentDate}.`,\n  keywords: `orbital mechanics simulator ${year}, satellite orbit simulator free, 3D space simulator online, learn orbital mechanics, NASA orbit calculator, ISS orbit time, how satellites orbit earth, space physics for kids, gravity simulator, orbital mechanics for PhD, aerospace research tools`,\n  ogTitle: `Orbital Simulator Hub | Free Satellite Orbit Simulator ${year}`,\n  ogDescription: `Free interactive 3D satellite orbit simulator. Learn orbital mechanics with real NASA physics. Perfect for students, scientists, and researchers.`\n};\n\nreturn {\n  json: seoUpdate\n};"
      },
